{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 30
    },
    "api/auth/verify-pin.ts": {
      "maxDuration": 30
    },
    "api/db/products.ts": {
      "maxDuration": 30
    },
    "api/db/courses.ts": {
      "maxDuration": 30
    },
    "api/db/providers.ts": {
      "maxDuration": 30
    },
    "api/db/users.ts": {
      "maxDuration": 30
    },
    "api/db/users/sync.ts": {
      "maxDuration": 30
    },
    "api/db/orders.ts": {
      "maxDuration": 30
    }
  }
}
